rules_version = '2';

// =============================================================================
// MignonciteShop — Firebase Storage Security Rules
// Déploiement : firebase deploy --only storage
//
// Images produits/catégories : upload authentifié, image uniquement, 2 Mo max.
// LIMITATION DOCUMENTÉE : les Storage Rules ne peuvent pas consulter
// Firestore, donc le rôle admin ne peut pas y être vérifié sans custom
// claims (Admin SDK — cf. FIREBASE-SETUP.md). Tout utilisateur connecté peut
// donc téléverser une image (bornée : 2 Mo, image/*) dans uploads/.
// Elle n'est LIÉE à aucun produit : seul l'admin modifie les produits.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Images publiques (lecture par la boutique).
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Chemin réservé à une future montée en gamme (custom claims admin) :
    // administrateurs vérifiés par claim — à activer avec l'Admin SDK.
    match /admin/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }
  }
}
