rules_version = '2';

// =============================================================================
// MignonciteShop — Cloud Firestore Security Rules
// Déploiement : firebase deploy --only firestore:rules
// (ou collage dans Console → Firestore → Règles, cf. FIREBASE-SETUP.md)
//
// Principe : TOUTE autorisation est vérifiée ICI (serveur Firebase), jamais
// uniquement en masquant des boutons côté client. Un utilisateur normal ne
// peut ni modifier un produit/prix, ni lire/modifier les commandes d'autrui,
// ni s'attribuer le rôle admin, ni toucher aux réglages.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- Helpers ----------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Bootstrap : aucun administrateur n'existe encore (geste 7 taps).
    function noAdminYet() {
      return !exists(/databases/$(database)/documents/settings/public)
        || get(/databases/$(database)/documents/settings/public).data.adminExists != true;
    }

    /* --------------------------- Utilisateurs -------------------------- */

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Création : son propre profil, rôle "customer". Le rôle "admin" n'est
      // acceptable que TANT QU'AUCUN admin n'existe (première installation).
      allow create: if signedIn()
        && request.auth.uid == uid
        && (request.resource.data.role == 'customer'
            || (request.resource.data.role == 'admin' && noAdminYet()));

      // Mise à jour : l'utilisateur (sans jamais changer son rôle) ou l'admin.
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role)
        || (isAdmin()
          && request.resource.data.role in ['customer', 'admin'])
      );

      // RGPD : suppression de son propre compte, ou purge par l'admin.
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    /* ------------------------ Catalogue produits ----------------------- */

    match /products/{productId} {
      // Lecture publique des produits ACTIFS uniquement ; l'admin voit tout.
      allow read: if (resource.data.isActive == true) || isAdmin();
      // Prix, stock, visibilité : modifications réservées à l'admin.
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ------------------------ Réglages boutique ------------------------ */

    match /settings/{docId} {
      allow read: if true; // frais de livraison publics, flag adminExists
      allow create, update, delete: if isAdmin();
    }

    /* ---------------------------- Commandes ---------------------------- */

    match /orders/{orderId} {
      // Création client : snapshot en statut "pending"/"unpaid" uniquement.
      // Les montants sont recalculés par le client depuis les PRIX FIRESTORE
      // (transaction) — l'admin valide visuellement avant expédition. La
      // validation cryptographique serveur nécessiterait une Cloud Function
      // (cf. FIREBASE-SETUP.md § Limitations connues).
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'unpaid'
        && (request.auth == null || request.resource.data.uid == request.auth.uid);

      // Lecture : admin, propriétaire (uid) ou même email que le compte.
      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.uid == request.auth.uid
                || resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email));

      allow update, delete: if isAdmin();
    }

    /* ------------- Suivi public (référence + email requis) ------------- */

    match /orderLookups/{lookupId} {
      // Lecture publique : l'identifiant du document contient référence ET
      // email — impossible à deviner sans les deux (comportement du suivi).
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    /* ----------------------------- Fidélité ---------------------------- */

    match /loyalty/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // LIMITATION DOCUMENTÉE : sans Cloud Functions, la créditation des
      // points est écrite par le client lors de la commande. Un utilisateur
      // technique pourrait modifier ses propres points. La mitigation
      // complète (calcul serveur) nécessite une fonction — voir
      // FIREBASE-SETUP.md. L'admin peut ajuster via l'espace client.
      allow write: if signedIn() && request.auth.uid == uid;

      match /transactions/{txId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if false; // piste d'audit immuable
      }
    }

    /* ------------------------------ Avis ------------------------------- */

    match /reviews/{reviewId} {
      allow read: if true;
      // Création : en attente de modération, jamais publié d'emblée.
      allow create: if signedIn()
        && request.resource.data.isApproved == false
        && request.resource.data.helpful == 0;
      allow update, delete: if isAdmin();
    }

    /* --------------------------- Codes promo --------------------------- */

    match /promos/{promoId} {
      allow read: if true; // validation publique (le code doit être connu)
      allow create, delete: if isAdmin();
      // Mise à jour admin ; les clients ne peuvent UNIQUEMENT incrémenter
      // usageCount de +1 lors d'une commande (aucun autre champ touché).
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
            && request.resource.data.usageCount == resource.data.usageCount + 1);
    }

    /* ------------------- Formulaires publics (create) ------------------ */

    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /newsletter/{subscriberId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /stockAlerts/{alertId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin(); // marquage "notifié" par l'admin
    }

    /* ---------------------------- Analytique --------------------------- */

    match /analytics/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    /* ---------------------- Transactions de paiement ------------------- */

    match /paymentTransactions/{txId} {
      allow create: if request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || (signedIn()
            && resource.data.orderId != null
            && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ---------------------------- Journaux ----------------------------- */

    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;      // confirmation/statut écrits par les flux client
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin(); // seules les actions admin sont tracées
      allow update, delete: if false;
    }
  }
}
