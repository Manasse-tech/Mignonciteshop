// Prisma schema — Clone MignonciteShop
// Supabase PostgreSQL : les listes primitives ne sont pas supportées par Prisma →
// gallery/sizes/colors sont stockées en STRINGS JSON (ex: '["S","M","L","XL"]').

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  image       String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  details     String   @default("")
  price       Float
  oldPrice    Float?
  image       String
  // STRING JSON (ex: '["/images/products/a.jpg","/images/products/b.jpg"]')
  gallery     String   @default("[]")
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stock       Int      @default(0)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  soldCount   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isNew       Boolean  @default(false)
  isActive    Boolean  @default(true)
  // STRING JSON (ex: '["S","M"]')
  sizes       String   @default("[]")
  // STRING JSON (ex: '["Noir"]')
  colors      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews      Review[]
  stockAlerts  StockAlert[]

  @@index([categoryId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Auth (NextAuth v4)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // hash bcrypt
  role          String    @default("customer") // customer | admin
  image         String?
  loyalty       LoyaltyAccount?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Marketing / contact
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Commandes (B2C checkout) — schéma prêt pour POST /api/orders
// ---------------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  reference      String      @unique // ex: MC-7F3K2A
  status         String      @default("pending") // pending | paid | shipped | delivered | cancelled
  email          String
  customerName   String
  phone          String?
  // Adresse de livraison dénormalisée (simplicité SQLite / une adresse par commande)
  addressLine1   String
  addressLine2   String?
  postalCode     String
  city           String
  country        String      @default("France")
  shippingMethod String      @default("standard") // standard | express | pickup
  shippingCost   Float       @default(0)
  subtotal       Float
  discount       Float       @default(0)
  total          Float
  promoCode      String?
  paymentMethod  String      @default("card") // card | paypal | transfer
  paymentStatus  String      @default("unpaid") // unpaid | paid | refunded
  transactionId  String? // identifiant du provider de paiement (ch_demo_… / ch_stripe_…)
  cardLast4      String? // 4 derniers chiffres seulement (jamais le numéro complet)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  payments       PaymentTransaction[]

  @@index([email])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  image       String
  unitPrice   Float
  quantity    Int
  size        String?
  color       String?

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Avis clients vérifiés + alertes de réassort + codes promo
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author     String
  rating     Int // 1..5
  title      String?
  comment    String
  isApproved Boolean  @default(false) // modération avant publication
  helpful    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model StockAlert {
  id        String   @id @default(cuid())
  email     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, productId])
  @@index([productId])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String    @default("")
  type        String // percent | freeship | amount
  value       Float     @default(0)
  minSubtotal Float     @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  usageCount  Int       @default(0)
  maxUses     Int?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Réglages boutique (clé/valeur) — pilotés depuis l'espace admin.
// Le serveur relit ces valeurs à CHAQUE commande (source de vérité).
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Analytics — événements de navigation/métier persistés (fin du no-op 204).
// Source : src/lib/analytics.ts côté client → POST /api/analytics.
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String // page_view | product_view | add_to_cart | purchase | ...
  page      String?  // page SPA concernée (?page=...)
  productId String?
  value     Float?   // montant éventuel (purchase…)
  meta      String   @default("{}") // JSON libre (payload restant)
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Journal des e-mails transactionnels « envoyés ».
// ---------------------------------------------------------------------------

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String // order_confirmation | order_status | restock_alert | welcome | password_reset | account_deleted
  body      String   @default("") // texte lisible (rendu simple)
  data      String   @default("{}") // JSON (référence commande, token, produit…)
  status    String   @default("logged") // logged | sent | failed
  error     String?
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Journal d'audit admin — trace écrite de chaque action sensible.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // email de l'admin
  action    String // product.create | order.status | promo.create | review.approve | ...
  target    String   @default("") // identifiant visé (id, référence…)
  details   String   @default("{}") // JSON (avant/après)
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Fidélité — un compte par utilisateur, points gagnés selon les dépenses.
// 1 point / 100 F CFA dépensés (bonus selon palier, voir src/lib/loyalty.ts).
// Toutes les variations passent par LoyaltyTransaction (piste d'audit).
// ---------------------------------------------------------------------------

model LoyaltyAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points        Int      @default(0) // solde disponible
  lifetimePoints Int     @default(0) // total accumulé (détermine le palier)
  tier          String   @default("bronze") // bronze | silver | gold
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  transactions  LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String // earn | redeem | adjust | expire
  points    Int // +/- (positif = gain, négatif = dépense/ajustement)
  reason    String // order:MC-XXXXXX | signup_bonus | manual | ...
  orderId   String?
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Paiements — transactions provider (mobile money / carte).
// Structure réelle : créée en « pending » par POST /api/payments/initiate,
// finalisée par le webhook du prestataire (signature x-webhook-secret).
// PAS de simulation : sans provider configuré, le paiement reste honnête.
// ---------------------------------------------------------------------------

model PaymentTransaction {
  id            String   @id @default(cuid())
  reference     String   @unique // ex: MC-PAY-7F3K2A
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  provider      String // mobile_money_wave | mobile_money_orange | mobile_money_mtn | mobile_money_moov | card
  amount        Float
  currency      String   @default("XOF")
  status        String   @default("pending") // pending | processing | success | failed | cancelled | expired
  providerTxId  String?
  phoneNumber   String?
  failureReason String?
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}
